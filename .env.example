# Copy to backend/.env for local development. Never put real secrets in git.

# Required — app will not start if any of these are empty
DATABASE_URL=postgresql+psycopg://hustle:hustle@localhost:5432/hustle
JWT_SECRET=dev-jwt-secret-change-me-32-chars-min
PHONE_HASH_PEPPER=dev-phone-pepper-change-me-32chars

# Optional for local auth testing; required in production for voice features
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Optional
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ANTHROPIC_MODEL=claude-sonnet-4-6
CORS_ORIGINS=http://localhost:5173
AUDIO_STORAGE_PATH=./storage/audio
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOG_LEVEL=INFO
