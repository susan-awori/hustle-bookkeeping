# Copy to .env for local development. Never put real secrets in git.

# Required — app will not start if any of these are empty
DATABASE_URL=postgresql+psycopg://hustle:hustle@localhost:5432/hustle
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
PHONE_HASH_PEPPER=replace-with-another-long-random-string
ELEVENLABS_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me

# Optional
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ANTHROPIC_MODEL=claude-sonnet-4-6
CORS_ORIGINS=http://localhost:5173
AUDIO_STORAGE_PATH=./storage/audio
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOG_LEVEL=INFO
